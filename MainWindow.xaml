<Window x:Class="MemoClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemoClip" Height="520" Width="580"
        MinHeight="320" MinWidth="400"
        Background="#F0F2F5"
        WindowStartupLocation="Manual">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Title Bar ===== -->
        <Border Grid.Row="0" Background="White" Height="48"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📝" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="MemoClip" FontSize="15" FontWeight="Bold"
                               Foreground="#1E293B" VerticalAlignment="Center"
                               FontFamily="Segoe UI"/>
                    <TextBlock x:Name="CountLabel" Text="· 0 memos" FontSize="12"
                               Foreground="#94A3B8" VerticalAlignment="Center"
                               Margin="12,0,0,0" FontFamily="Segoe UI"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="—" Style="{StaticResource IconButtonStyle}"
                            Click="Minimize_Click" ToolTip="Minimize"
                            FontSize="12" FontWeight="Bold"/>
                    <Button Content="✕" Style="{StaticResource IconButtonStyle}"
                            Click="Close_Click" ToolTip="Hide to tray"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Search + Add Bar ===== -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box with icon -->
                <Border Grid.Column="0" Background="White" CornerRadius="8"
                        BorderBrush="#E2E8F0" BorderThickness="1" Height="40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14"
                                   VerticalAlignment="Center" Margin="12,0,6,0"
                                   Foreground="#94A3B8"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Style="{StaticResource SearchBoxStyle}"
                                 BorderThickness="0" Background="Transparent"
                                 TextChanged="SearchBox_TextChanged"
                                 VerticalAlignment="Stretch"
                                 FontFamily="Segoe UI" FontSize="13.5"
                                 Padding="6,10,12,10">
                            <TextBox.Resources>
                                <VisualBrush x:Key="HintBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="🔍  Search memos..." FontSize="13.5"
                                                   Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Add button -->
                <Button Grid.Column="1" Content="➕  Add Memo"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,0,0" Height="40" Width="130"
                        Click="AddMemo_Click"/>
            </Grid>
        </Border>

        <!-- ===== Memo List ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Padding="16,12,16,8" Background="#F0F2F5">
            <Grid>
                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" Visibility="Visible"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,60,0,0">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="No memos yet" FontSize="17" FontWeight="SemiBold"
                               Foreground="#64748B" HorizontalAlignment="Center"
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="Click 「➕ Add Memo」or press Ctrl+N to create one"
                               FontSize="13" Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,6,0,0"
                               FontFamily="Segoe UI"/>
                </StackPanel>

                <!-- Memo cards -->
                <ItemsControl x:Name="MemoListControl" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MemoCardStyle}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#10000000" BlurRadius="6"
                                                      ShadowDepth="1" Direction="270" Opacity="0.3"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Key -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Key}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1E293B" FontFamily="Segoe UI"
                                               TextWrapping="Wrap"
                                               Margin="0,0,8,4"/>

                                    <!-- Value -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding Value}"
                                               FontSize="13" FontFamily="Consolas"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               Margin="0,0,8,0"
                                               MaxHeight="120"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="✎" Style="{StaticResource IconButtonStyle}"
                                                Click="EditMemo_Click" Tag="{Binding}"
                                                ToolTip="Edit"/>
                                        <Button Content="✕" Style="{StaticResource IconButtonStyle}"
                                                Click="DeleteMemo_Click" Tag="{Binding}"
                                                ToolTip="Delete" Margin="4,0,0,0">
                                            <Button.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ===== Status Bar ===== -->
        <Border Grid.Row="3" Background="White" Height="28"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Text="Ready" FontSize="11"
                       Foreground="#94A3B8" VerticalAlignment="Center"
                       Margin="14,0" FontFamily="Segoe UI"/>
        </Border>
    </Grid>
</Window>
