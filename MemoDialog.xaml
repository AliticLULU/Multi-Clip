<Window x:Class="MemoClip.MemoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Memo" Height="320" Width="480"
        ResizeMode="NoResize"
        Background="White"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Key -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Key"
                   FontSize="13" FontWeight="SemiBold" Foreground="#64748B"
                   VerticalAlignment="Center" Margin="0,0,14,0"
                   FontFamily="Segoe UI"/>
        <TextBox x:Name="KeyBox" Grid.Row="0" Grid.Column="1"
                 FontSize="14" FontFamily="Segoe UI"
                 Padding="10,8" Margin="0,0,0,14"
                 BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- Value -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Value"
                   FontSize="13" FontWeight="SemiBold" Foreground="#64748B"
                   VerticalAlignment="Top" Margin="0,6,14,0"
                   FontFamily="Segoe UI"/>
        <TextBox x:Name="ValueBox" Grid.Row="1" Grid.Column="1" Grid.RowSpan="3"
                 FontSize="13.5" FontFamily="Consolas"
                 Padding="10,8" Margin="0,0,0,14"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinLines="4"
                 BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Height="36"
                    Click="Cancel_Click" IsCancel="True"
                    FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                    Background="White" Foreground="#1E293B"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    Cursor="Hand" Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Save" Width="90" Height="36"
                    Click="Save_Click" IsDefault="True"
                    FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                    Background="#4F6EF7" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
